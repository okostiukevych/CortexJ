<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.cortexj</groupId>
    <artifactId>cortexj-parent</artifactId>
    <version>1.0.1</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>cortexj-maven-plugin</artifactId>
  <packaging>maven-plugin</packaging>
  <name>CortexJ Maven Plugin</name>
  <dependencies>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-repository-local</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-repository-huggingface</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- audit 2026-10-07 (#148): engines are verification fixtures, not a
         layering dependency - DeploymentVerifier only iterates discovered
         providers (health + plannability, never load) and degrades to
         plan-only checks when an engine is absent from the plugin realm.
         Optional so consumers can swap the engine set without forking. -->
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-runtime-onnx</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-runtime-llamacpp</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-plugin-api</artifactId>
      <version>3.10.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-core</artifactId>
      <version>3.8.4</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.plugin-tools</groupId>
      <artifactId>maven-plugin-annotations</artifactId>
      <version>3.6.4</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-plugin-plugin</artifactId>
        <version>3.6.4</version>
      </plugin>
    </plugins>
  </build>
</project>
