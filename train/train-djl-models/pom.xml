<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.cortexj</groupId>
    <artifactId>cortexj-parent</artifactId>
    <version>1.0.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>cortexj-train-djl-models</artifactId>
  <name>CortexJ Train DJL Models</name>
  <description>Generic Llama-family decoder as pure-Java DJL blocks, HF safetensors weight loading, LoRA wiring (ADR-021/022). Depends on the DJL engine only.</description>
  <properties>
    <cortexj.shared.release>17</cortexj.shared.release>
  </properties>
  <dependencies>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-train-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-train-data</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-train-peft</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-convert-safetensors</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>ai.djl</groupId>
      <artifactId>api</artifactId>
      <version>0.39.0</version>
    </dependency>
    <dependency>
      <groupId>ai.djl.huggingface</groupId>
      <artifactId>tokenizers</artifactId>
      <version>0.39.0</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-convert-safetensors</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <!-- Opt-in live lane: the DJL PyTorch engine (native) makes the
         engine-gated contract tests execute instead of skipping loudly.
         Activate with -Plive-engine on the same machine that ran the
         verification lanes (macOS arm64 here). -->
    <profile>
      <id>live-engine</id>
      <dependencies>
        <dependency>
          <groupId>ai.djl.pytorch</groupId>
          <artifactId>pytorch-engine</artifactId>
          <version>0.39.0</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>ai.djl.pytorch</groupId>
          <artifactId>pytorch-native-cpu</artifactId>
          <classifier>osx-aarch64</classifier>
          <version>2.7.1</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
