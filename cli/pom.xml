<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.cortexj</groupId>
    <artifactId>cortexj-parent</artifactId>
    <version>1.0.0-RC1</version>
  </parent>
  <artifactId>cortexj-cli</artifactId>
  <name>CortexJ CLI</name>
  <dependencies>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-train-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-train-data</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-train-djl</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-train-djl-models</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-platform-java8</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-platform-java11</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-platform-java17</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-platform-java21</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-platform-java25</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-repository-local</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-repository-huggingface</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-observability</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-repository-http</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-convert-gguf</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-server</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-runtime-remote-openai</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-runtime-onnx</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-runtime-llamacpp</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-runtime-djl</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <version>1.4.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.cortexj.cli.CortexJMain</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
