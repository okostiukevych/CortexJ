      <artifactId>cortexj-model</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-convert-gguf</artifactId>
      <version>${project.version}</version>
    </dependency>
