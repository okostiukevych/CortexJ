<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs triage (reliability audit 2026-09-27, issue #53; scoped by audit 2026-10-05, issue #109).
  Every suppression carries a justification; findings outside this list fail the build.
-->
<FindBugsFilter>

  <!-- Public API value types and SPI request/response types expose their
       metadata maps and builder collections by contract. The maps are
       defensively copied / wrapped in Collections.unmodifiableMap at the
       construction sites and never mutated post-construction (verified by
       BuilderImmutabilityTest, the #22 frozen-builder fix and the audit).
       SpotBugs cannot trace the conditional unmodifiable wrap through the
       constructors, so these are false positives.
       audit #109: scoped to the exact value types instead of suppressing the
       pattern globally - the encapsulation checks stay active for every
       implementation package (core, cache, converters, worker, runtimes,
       server). A new API value type that trips the check gets an explicit,
       justified line here. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    <Or>
      <Class name="io.cortexj.CortexJBuilder"/>
      <Class name="io.cortexj.hardware.EnvironmentProfile"/>
      <Class name="io.cortexj.inference.GenerationResponse"/>
      <Class name="io.cortexj.inference.InferenceResponse"/>
      <Class name="io.cortexj.inference.RerankingRequest"/>
      <Class name="io.cortexj.model.ChatMessage"/>
      <Class name="io.cortexj.model.ModelArtifact$Abstract"/>
      <Class name="io.cortexj.observability.PlatformEvent"/>
      <Class name="io.cortexj.planner.ExecutionRequest"/>
      <Class name="io.cortexj.planner.ExecutionRequest$Builder"/>
      <Class name="io.cortexj.runtime.DeviceDescriptor"/>
      <Class name="io.cortexj.spi.conversion.ConversionRequest"/>
      <Class name="io.cortexj.spi.repository.ResolvedArtifact$Abstract"/>
      <Class name="io.cortexj.spi.runtime.RuntimeModelRequest"/>
      <Class name="io.cortexj.spi.runtime.RuntimeOpenRequest"/>
      <Class name="io.cortexj.spi.runtime.RuntimeProbeContext"/>
      <Class name="io.cortexj.spi.runtime.RuntimeProbeResult"/>
      <Class name="io.cortexj.stream.Token"/>
    </Or>
  </Match>

  <!-- audit 2026-10-10: full-reactor spotbugs surfaced pre-existing findings
       in the incubating modules (research/nn/autograd/tensor - the release
       train lists them as 0.x incubating). The exposure findings there are
       INTENTIONAL aliasing, not encapsulation bugs:
       - nn.Linear/ShardedLinear weight/bias and autograd Variable/TapeNode
         data alias live storage shared with optimizers and the tape graph
         (in-place updates are the semantics; a defensive copy would fork
         state and break training).
       - tensor.cpu CpuTensor storage aliases the parent array for views
         (ADR-024: isView(), closing a view never frees parent data).
       - research Cards value holders expose list/map snapshots the same way
         as the already-excluded API value types above.
       Each class below is listed explicitly; the encapsulation checks stay
       active everywhere else. -->
  <!-- GgufDocument is an internal parsed-DTO: read() fills version and
       dataStartOffset mutably and the converter/tests read them directly -
       restructuring into a builder would churn six test files for zero
       behavioral gain. -->
  <Match>
    <Bug pattern="PA_PUBLIC_PRIMITIVE_ATTRIBUTE"/>
    <Class name="io.cortexj.convert.gguf.internal.GgufDocument"/>
  </Match>

  <!-- HardwareProbe checks for the Metal framework at its fixed macOS
       system location - the absolute path IS the probe. -->
  <Match>
    <Bug pattern="DMI_HARDCODED_ABSOLUTE_FILENAME"/>
    <Class name="io.cortexj.hardware.internal.HardwareProbe"/>
  </Match>

  <!-- Value-type constructors that validate and throw (ModelArtifact.Abstract
       rejects negative sizes; LibTorchBackend rejects a missing native
       engine at construction) - a half-constructed instance never escapes
       because the exception aborts the assignment. -->
  <Match>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    <Or>
      <Class name="io.cortexj.model.ModelArtifact$Abstract"/>
      <Class name="io.cortexj.tensor.libtorch.LibTorchBackend"/>
    </Or>
  </Match>

  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    <Or>
      <Class name="io.cortexj.autograd.Autograd"/>
      <Class name="io.cortexj.autograd.GradientHooks$Hook"/>
      <Class name="io.cortexj.autograd.TapeNode"/>
      <Class name="io.cortexj.autograd.Variable"/>
      <Class name="io.cortexj.nn.Linear"/>
      <Class name="io.cortexj.nn.ShardedLinear"/>
      <Class name="io.cortexj.research.Cards$Citation"/>
      <Class name="io.cortexj.research.Cards$ExperimentBundle"/>
      <Class name="io.cortexj.tensor.cpu.CpuBackend$CpuTensor"/>
      <Class name="io.cortexj.tensor.libtorch.LibTorchBackend"/>
    </Or>
  </Match>

  <!-- Quantization implements Comparable for deterministic ordering of
       quantization variants; equals() is deliberately not overridden
       (identity semantics for an enum-like value type). -->
  <Match>
    <Bug pattern="EQ_COMPARETO_USE_OBJECT_EQUALS"/>
  </Match>

  <!-- ModelArtifact.Abstract is the SPI base for anonymous artifact holders;
       its constructor throws on invalid input by design and no finalizers
       exist anywhere in the codebase, so the finalizer-attack vector does not
       apply. -->
  <Match>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
  </Match>

  <!-- DefaultModelHandle's guarded regions (execute/generate/stream/embed/close)
       release the session lock in an unconditional finally; SpotBugs's lock
       analysis is conservative about calls between lock() and the try block.
       The serialization is proven by SessionScopedDispatchTest (zero interleaved
       entries) and ModelHandleClosedDispatchTest. -->
  <Match>
    <Bug pattern="UL_UNRELEASED_LOCK_EXCEPTION_PATH"/>
    <Class name="io.cortexj.core.DefaultModelHandle"/>
  </Match>

  <!-- The SSE workers' catch (Exception) in LlamaServerTokenStream.runSse and
       RemoteOpenAiRuntime's stream worker is deliberate: the token consumer is
       user code that may throw anything, and the worker must convert every
       failure into onError instead of dying silently (audit #10/#11). -->
  <Match>
    <Bug pattern="REC_CATCH_EXCEPTION"/>
    <Class name="io.cortexj.runtime.llamacpp.LlamaServerModel$LlamaServerTokenStream"/>
  </Match>

  <!-- GgufDocument is an internal mutable container shared by the GGUF
       readers and writers (io.cortexj.convert.gguf.internal, not public API);
       its public primitive fields are the container's contract for the
       converter pipeline. -->
  <Match>
    <Bug pattern="PA_PUBLIC_PRIMITIVE_ATTRIBUTE"/>
    <Class name="io.cortexj.convert.gguf.internal.GgufDocument"/>
  </Match>

  <!-- HardwareProbe checks for the Metal framework at its fixed macOS
       system location - the absolute path IS the probe. -->
  <Match>
    <Bug pattern="DMI_HARDCODED_ABSOLUTE_FILENAME"/>
    <Class name="io.cortexj.hardware.internal.HardwareProbe"/>
  </Match>

  <!-- Value-type constructors that validate and throw (ModelArtifact.Abstract
       rejects negative sizes; LibTorchBackend rejects a missing native
       engine at construction) - a half-constructed instance never escapes
       because the exception aborts the assignment. -->
  <Match>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    <Or>
      <Class name="io.cortexj.model.ModelArtifact$Abstract"/>
      <Class name="io.cortexj.tensor.libtorch.LibTorchBackend"/>
    </Or>
  </Match>

  <!-- HardwareProbe.detectMetal checks the macOS system framework path by
       design: /System/Library/Frameworks/Metal.framework is the documented
       probe location for Metal detection. -->
  <Match>
    <Bug pattern="DMI_HARDCODED_ABSOLUTE_FILENAME"/>
    <Class name="io.cortexj.hardware.internal.HardwareProbe"/>
  </Match>

  <!-- CacheStorage.put's fallback ladder retries the atomic replace with a
       short bounded backoff under the per-key lock. The wait happens BEFORE
       any delete, so the target stays present the whole time and concurrent
       get()/contains() never observe a missing-artifact window (Windows CI
       flake: a scanner holds the freshly written temp open without
       share-delete). The lock is per-key (striped 16) and the path is rare -
       only filesystems that reject the atomic replace under transient
       interference - so the bounded 20ms backoff does not stall other keys. -->
  <Match>
    <Bug pattern="SWL_SLEEP_WITH_LOCK_HELD"/>
    <Class name="io.cortexj.cache.CacheStorage"/>
  </Match>

  <!-- DefaultCortexJ.models() returns the io.cortexj.Models implementation by
       interface contract - DefaultModels IS the implementation object handed
       to callers, not an internal array or map escaping the encapsulation. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP"/>
    <Class name="io.cortexj.core.DefaultCortexJ"/>
  </Match>

  <!-- transitionTo wakes waitForReady waiters with notifyAll() while the state
       change itself is an AtomicReference CAS outside the monitor (audit M-7):
       the CAS precedes the notify in program order and every waiter re-checks
       the volatile state after each wake, so the visibility is guaranteed by
       the monitor handoff - SpotBugs wants the mutation inside the same block. -->
  <Match>
    <Bug pattern="NN_NAKED_NOTIFY"/>
    <Class name="io.cortexj.core.DefaultModelHandle"/>
  </Match>

  <!-- The loadAsync task body (audit #89) acquires the loadLock read lock and
       releases it in an unconditional finally; SpotBugs is conservative about
       the anonymous Runnable's lock/unlock paths. The barrier contract is
       proven by LoadAsyncCloseBarrierTest and PlatformCloseBarrierTest. -->
  <Match>
    <Bug pattern="UL_UNRELEASED_LOCK_EXCEPTION_PATH"/>
    <!-- regex: anonymous-class numbering shifts whenever DefaultModels
         gains/loses an anonymous class (audit 2026-10-10: pinLocks stripes) -->
    <Class name="~io\.cortexj\.core\.DefaultModels\$[0-9]+"/>
  </Match>

  <!-- ModelBundler's constructor stores the shared CacheStorage reference:
       CacheStorage is a live collaborator (not a value type) and the bundler
       is constructed once by the CLI with the platform's cache instance - a
       defensive copy of a cache directory handle is meaningless. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
    <Class name="io.cortexj.repository.local.bundle.ModelBundler"/>
  </Match>

  <!-- WorkerCodec.mapper shares one Jackson ObjectMapper across the protocol:
       an ObjectMapper is thread-safe after configuration and is configured
       once at class initialization - exposing it is the codec's contract. -->
  <Match>
    <Bug pattern="MS_EXPOSE_REP"/>
    <Class name="io.cortexj.worker.WorkerCodec"/>
  </Match>

  <!-- WorkerHost.emit calls System.exit(0) when the parent process died
       (stdout write failed): exiting instead of spinning is the worker's
       orphan-free teardown contract - the reason is logged to stderr first.
       This is the worker HOST main process, not a library embed path. -->
  <Match>
    <Bug pattern="DM_EXIT"/>
    <Class name="io.cortexj.worker.WorkerHost"/>
  </Match>

  <!-- WorkerChannel's CAPPED_LINE_MARKER (audit #99) is a deliberately
       distinct String instance used for IDENTITY comparison only: an
       equal-content line must never be confused with the oversized-line
       sentinel, which is exactly what new String(...) guarantees. -->
  <Match>
    <Bug pattern="DM_STRING_CTOR"/>
    <Class name="io.cortexj.runtime.isolated.WorkerChannel"/>
  </Match>

  <!-- GgufBinaryReader/Writer wrap a caller-provided stream: wrapping the
       stream is the standard reader/writer contract (the stream is a live
       collaborator, not a value type to defensively copy). -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
    <Or>
      <Class name="io.cortexj.convert.gguf.internal.GgufBinaryReader"/>
      <Class name="io.cortexj.convert.gguf.internal.GgufBinaryWriter"/>
    </Or>
  </Match>

  <!-- GenericDecoderBlock stores the trainer's NDManager for the Block
       lifetime: DJL Block.forward has no manager parameter and DJL 0.38 does
       not expose NDArray.getManager(), so the block must hold the manager
       that loaded the weights (DjlTrainingLoop drives one manager across
       train/forward; the trainer's own loop creates and closes it). This is
       the live-collaborator idiom, same class as ModelBundler above. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
    <Class name="io.cortexj.train.djl.models.GenericDecoderBlock"/>
  </Match>

</FindBugsFilter>
