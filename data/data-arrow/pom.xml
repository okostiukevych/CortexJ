<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.cortexj</groupId>
    <artifactId>cortexj-parent</artifactId>
    <version>1.0.2</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>cortexj-data-arrow</artifactId>
  <name>CortexJ Data Arrow</name>
  <description>Arrow IPC adapter over the Data API (ADR-019): file/streaming format round-trip. The library never leaks into data-api signatures.</description>
  <properties>
    <cortexj.shared.release>17</cortexj.shared.release>
    <arrow.version>19.0.0</arrow.version>
    <!-- arrow 19 pulls netty-buffer 4.2.x whose allocator init fails on
         JDK 25 (UnsafeDirectLittleEndian -> EmptyByteBuf.memoryAddress UOE).
         Pinning 4.1.x restores the JDK-25-safe unsafe path, unchanged from
         arrow 18 behavior. -->
    <netty-buffer.version>4.1.139.Final</netty-buffer.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-data-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-vector</artifactId>
      <version>${arrow.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-memory-netty</artifactId>
      <version>${arrow.version}</version>
      <scope>runtime</scope>
      <exclusions>
        <exclusion>
          <groupId>io.netty</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- pinned netty-buffer for the JDK-25 allocator compatibility (see version comment) -->
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-buffer</artifactId>
      <version>${netty-buffer.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-common</artifactId>
      <version>${netty-buffer.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- Arrow schema serialization needs annotations at runtime -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
      <version>2.22</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Arrow memory requires reflective access to java.nio buffers -->
          <argLine>--add-opens=java.base/java.nio=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
