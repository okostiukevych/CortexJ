<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.cortexj</groupId>
    <artifactId>cortexj-parent</artifactId>
    <version>1.0.2</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>cortexj-data-parquet</artifactId>
  <name>CortexJ Data Parquet</name>
  <description>Parquet file adapter over the Data API (ADR-019). The Parquet library never leaks into data-api signatures.</description>
  <properties>
    <cortexj.shared.release>17</cortexj.shared.release>
    <parquet.version>1.18.1</parquet.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>io.cortexj</groupId>
      <artifactId>cortexj-data-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.parquet</groupId>
      <artifactId>parquet-hadoop</artifactId>
      <version>${parquet.version}</version>
    </dependency>
    <!-- parquet-hadoop declares Hadoop provided: local-filesystem reads
         need it on the classpath, isolated in this adapter (ADR-019).
         3.4.3 (not parquet's 3.3.0 default): 3.3.0/3.4.1 call the removed
         Subject.getSubject API and die on JDK 24+; fixed upstream since -->
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-client</artifactId>
      <version>3.4.3</version>
      <!-- Supply chain (post-1.0.2 weekly CVE lane): this module reads/writes
           Parquet files. The hadoop fat client drags in its embedded HTTP
           server security layer (jetty-security: CVE-2026-5795/10050, fixes
           exist only on unattainable 9.4.61/9.4.63) and the YARN websocket
           client (jetty-io/http: CVE-2026-2332, needs unreachable 9.4.60)
           which the data path never loads. Excluding them keeps the
           unpatchable-on-9.4 CVEs off the classpath. jetty-servlet/webapp/xml
           util(-ajax) remain, pinned by the parent jetty-bom to 9.4.58.v20250814
           (final public 9.4 release, fixes CVE-2025-5115). -->
      <exclusions>
        <exclusion>
          <groupId>org.eclipse.jetty</groupId>
          <artifactId>jetty-security</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.eclipse.jetty.websocket</groupId>
          <artifactId>websocket-client</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.eclipse.jetty.websocket</groupId>
          <artifactId>websocket-common</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.eclipse.jetty.websocket</groupId>
          <artifactId>websocket-api</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>
</project>
