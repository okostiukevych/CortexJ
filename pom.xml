  <profile>
    <id>spotbugs</id>
    <build>
      <plugins>
        <plugin>
          <groupId>com.github.spotbugs</groupId>
          <artifactId>spotbugs-maven-plugin</artifactId>
          <!-- 4.9.8.x bundles ASM that reads JDK 25 class files (major 69);
               4.8.6.2 crashed the analysis on JDK 25 -->
          <version>4.9.8.5</version>
          <configuration>
            <effort>Max</effort>
            <threshold>Medium</threshold>
            <xmlOutput>true</xmlOutput>
            <failOnError>true</failOnError>
            <excludeFilterFile>${maven.multiModuleProjectDirectory}/spotbugs-exclude.xml</excludeFilterFile>
          </configuration>
          <executions>
