            </execution>
          </executions>
        </plugin>
      </plugins>
    </build>
  </profile>

  <!-- Maven Central publication (explicit: -Prelease).
       Attaches sources + javadoc jars, signs them (GPG), and hands the
       bundle to the Central portal. Normal builds are unaffected.
       Prerequisites: OSSRH account with the io.cortexj namespace verified,
       a GPG key published to a keyserver, and server credentials in
       ~/.m2/settings.xml under the id 'central':
         <server><id>central</id><username>TOKEN-USER</username>
                 <password>TOKEN</password></server>
       Full procedure: docs/releasing.md -->
  <profile>
    <id>release</id>
    <build>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>${maven-source-plugin.version}</version>
          <executions>
            <execution>
              <id>attach-sources</id>
              <goals>
                <goal>jar-no-fork</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>${maven-javadoc-plugin.version}</version>
          <configuration>
            <!-- javadoc links must target the artifact's own language level,
                 never the building JDK -->
            <release>${cortexj.shared.release}</release>
            <doclint>-missing</doclint>
            <quiet>true</quiet>
          </configuration>
          <executions>
            <execution>
              <id>attach-javadoc</id>
              <goals>
                <goal>jar</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-gpg-plugin</artifactId>
          <version>${maven-gpg-plugin.version}</version>
          <executions>
            <execution>
              <id>sign-artifacts</id>
              <phase>verify</phase>
              <goals>
                <goal>sign</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.sonatype.central</groupId>
          <artifactId>central-publishing-maven-plugin</artifactId>
          <version>${central-publishing-plugin.version}</version>
          <extensions>true</extensions>
          <configuration>
            <publishingServerId>cortexj-central</publishingServerId>
            <!-- first releases land in the portal waiting room: a human
                 reviews and hits publish; never auto-release unattended -->
            <autoPublish>false</autoPublish>
            <waitUntil>validated</waitUntil>
          </configuration>
        </plugin>
      </plugins>
    </build>
  </profile>

  <!-- Static Maven repository for GitHub Pages. Produces the same artifacts as
       a Central release (sources + javadoc) without GPG or portal validation:
         mvn clean deploy -Ppages -DskipTests
       writes a complete Maven layout to target/pages-repo, published to the
       CortexJ-maven repository. Override the location with
       -Dcortexj.pages.repo=/absolute/path if needed. -->
  <profile>
    <id>pages</id>
    <properties>
      <cortexj.pages.repo>${maven.multiModuleProjectDirectory}/target/pages-repo</cortexj.pages.repo>
    </properties>
    <build>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>${maven-source-plugin.version}</version>
          <executions>
            <execution>
              <id>attach-sources</id>
              <goals>
                <goal>jar-no-fork</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>${maven-javadoc-plugin.version}</version>
          <configuration>
            <release>${cortexj.shared.release}</release>
            <doclint>-missing</doclint>
            <quiet>true</quiet>
          </configuration>
          <executions>
            <execution>
              <id>attach-javadoc</id>
              <goals>
                <goal>jar</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </build>
    <distributionManagement>
      <repository>
        <id>cortexj-pages</id>
        <url>file://${cortexj.pages.repo}</url>
      </repository>
    </distributionManagement>
  </profile>
</profiles>

  <!-- Baseline repository for the japicmp compat profile (the binary-compatibility gate): the
       GitHub Pages Maven repository publishes released versions; resolution
       requires this declaration (Central remains a future channel). -->
  <repositories>
    <repository>
      <id>cortexj-maven</id>
      <url>https://okostiukevych.github.io/CortexJ-maven/</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>

  <dependencyManagement>
    <dependencies>
      <!-- Dependency hygiene (Audit-2/#242): netty arrives transitively
           (hadoop/avro via data-parquet, arrow-memory-netty via data-arrow)
           at different 4.1.x patch levels. Importing the netty BOM pins the
           whole reactor to one patched line, so CVEs in one transitive path
           cannot survive behind another module's own resolution. -->
      <!-- Dependency hygiene (Audit-2/#242): transitive versions pinned to
           patched releases. tools.jackson 3.0.3 (spring-ai transitive) has
           CVE-2026-29062 (7.5); icu4j 74.2 (arrow/tablesaw transitive) has
           CVE-2025-5222; jline-style 3.27.1 (tribuo transitive) has
           CVE-2026-56740/56741. -->
      <dependency>
        <groupId>tools.jackson.core</groupId>
        <artifactId>jackson-core</artifactId>
        <version>3.2.4</version>
      </dependency>
      <dependency>
        <groupId>tools.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>3.2.4</version>
      </dependency>
      <dependency>
        <groupId>tools.jackson.core</groupId>
        <artifactId>jackson-annotations</artifactId>
        <version>3.2.4</version>
      </dependency>
      <dependency>
        <groupId>com.ibm.icu</groupId>
        <artifactId>icu4j</artifactId>
        <version>79.1</version>
      </dependency>
      <dependency>
        <groupId>org.jline</groupId>
        <artifactId>jline-style</artifactId>
        <version>3.29.0</version>
      </dependency>
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-bom</artifactId>
        <version>${netty.bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>com.microsoft.onnxruntime</groupId>
        <artifactId>onnxruntime</artifactId>
        <version>${onnxruntime.version}</version>
      </dependency>
      <dependency>
        <groupId>com.qxotic</groupId>
        <artifactId>jinfer-chat</artifactId>
        <version>${jinfer.version}</version>
      </dependency>
      <dependency>
        <groupId>io.opentelemetry</groupId>
        <artifactId>opentelemetry-api</artifactId>
        <version>${opentelemetry.version}</version>
      </dependency>
      <dependency>
        <groupId>io.opentelemetry</groupId>
        <artifactId>opentelemetry-sdk</artifactId>
        <version>${opentelemetry.version}</version>
      </dependency>
      <dependency>
        <groupId>io.opentelemetry</groupId>
        <artifactId>opentelemetry-sdk-testing</artifactId>
        <version>${opentelemetry.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${cortexj.shared.release}</release>
            <compilerArgs>
              <arg>-Xlint:-options</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <!-- audit #128: perf-tagged tests are separated from the default
                 run; execute them explicitly with -Pperf -->
            <excludedGroups>${surefire.excludedGroups}</excludedGroups>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-jdk</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[8,)</version>
                  <message>CortexJ requires JDK 8+ to build. The base module set targets Java 8; LTS platform modules (java11/17/21/25) activate automatically on newer JDKs.</message>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
