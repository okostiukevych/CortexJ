<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.cortexj</groupId>
  <artifactId>cortexj-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>CortexJ Parent</name>
  <description>CortexJ - AI runtime orchestration and model portability platform for the JVM</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.encoding>UTF-8</maven.compiler.encoding>

    <cortexj.shared.release>8</cortexj.shared.release>

    <jackson.version>2.17.1</jackson.version>
    <junit.version>5.10.2</junit.version>
    <onnxruntime.version>1.19.0</onnxruntime.version>
    <opentelemetry.version>1.49.0</opentelemetry.version>

    <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
    <maven-enforcer-plugin.version>3.4.1</maven-enforcer-plugin.version>
    <maven-jar-plugin.version>3.4.1</maven-jar-plugin.version>
    <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
  </properties>

  <modules>
    <module>bom</module>
    <module>api</module>
    <module>spi</module>
    <module>model</module>
    <module>hardware</module>
    <module>cache</module>
    <module>streaming</module>
    <module>observability</module>
    <module>planner</module>
    <module>core</module>
    <module>repositories/local</module>
    <module>repositories/huggingface</module>
    <module>repositories/http</module>
    <module>runtimes/remote-openai</module>
    <module>runtimes/onnx</module>
    <module>runtimes/llamacpp</module>
    <module>runtimes/djl</module>
    <module>converters/gguf</module>
    <module>server</module>
    <module>maven-plugin</module>
    <module>platform/java8</module>
    <module>starters/java8</module>
    <module>tck</module>
  </modules>

  <profiles>
    <profile>
      <id>jdk8-compiler</id>
      <activation>
        <jdk>1.8</jdk>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <release combine.self="override"/>
              <source>8</source>
              <target>8</target>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>jdk11plus</id>
      <activation>
        <jdk>[11,)</jdk>
      </activation>
      <modules>
        <module>platform/java11</module>
        <module>starters/java11</module>
        <module>streaming/flow</module>
      </modules>
    </profile>
    <profile>
      <id>jdk17plus</id>
      <activation>
        <jdk>[17,)</jdk>
      </activation>
      <modules>
        <module>platform/java17</module>
        <module>starters/java17</module>
        <module>integrations/spring-ai</module>
        <module>integrations/langchain4j</module>
      </modules>
    </profile>
    <profile>
      <id>jdk21plus</id>
      <activation>
        <jdk>[21,)</jdk>
      </activation>
      <modules>
        <module>platform/java21</module>
        <module>starters/java21</module>
      </modules>
    </profile>
    <profile>
      <id>jdk25plus</id>
      <activation>
        <jdk>[25,)</jdk>
      </activation>
      <modules>
        <module>platform/java25</module>
        <module>starters/java25</module>
        <module>cli</module>
      </modules>
    </profile>
  
  <profile>
    <id>jpms</id>
    <build>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>3.6.1</version>
          <executions>
            <execution>
              <id>jpms-classpath</id>
              <phase>generate-sources</phase>
              <goals>
                <goal>build-classpath</goal>
              </goals>
              <configuration>
                <outputFile>${project.build.directory}/jpms-classpath.txt</outputFile>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.1.0</version>
          <executions>
            <execution>
              <id>compile-module-info</id>
              <phase>process-classes</phase>
              <goals>
                <goal>exec</goal>
              </goals>
              <configuration>
                <executable>/bin/sh</executable>
                <arguments>
                  <argument>-c</argument>
                  <argument>test -r ${project.basedir}/src/main/jpms/module-info.java || exit 0; mod=$(sed -n 's/^\(open \)\{0,1\}module \([a-zA-Z0-9._]*\).*/\2/p' ${project.basedir}/src/main/jpms/module-info.java); test -n "$mod" || exit 0; mkdir -p ${project.build.outputDirectory}/META-INF/versions/9; MP=$(cat ${project.build.directory}/jpms-classpath.txt); if test -n "$MP"; then MPFLAG="--module-path $MP"; else MPFLAG=""; fi; ${java.home}/bin/javac --release 9 -d ${project.build.outputDirectory}/META-INF/versions/9 --patch-module "$mod=${project.build.outputDirectory}" $MPFLAG ${project.basedir}/src/main/jpms/module-info.java</argument>
                </arguments>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <configuration>
            <archive>
              <manifestEntries>
                <Multi-Release>true</Multi-Release>
              </manifestEntries>
            </archive>
          </configuration>
        </plugin>
      </plugins>
    </build>
  </profile>
</profiles>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>com.microsoft.onnxruntime</groupId>
        <artifactId>onnxruntime</artifactId>
        <version>${onnxruntime.version}</version>
      </dependency>
      <dependency>
        <groupId>io.opentelemetry</groupId>
        <artifactId>opentelemetry-api</artifactId>
        <version>${opentelemetry.version}</version>
      </dependency>
      <dependency>
        <groupId>io.opentelemetry</groupId>
        <artifactId>opentelemetry-sdk</artifactId>
        <version>${opentelemetry.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${cortexj.shared.release}</release>
            <compilerArgs>
              <arg>-Xlint:-options</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-jdk</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[8,)</version>
                  <message>CortexJ requires JDK 8+ to build. The base module set targets Java 8; LTS platform modules (java11/17/21/25) activate automatically on newer JDKs.</message>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
